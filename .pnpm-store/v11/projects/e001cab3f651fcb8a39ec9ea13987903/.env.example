PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
OTP_SECRET=replace_with_a_different_long_random_secret

# ----------------------------------------------------
# 1. Firebase Admin SDK
# Configure these fields in Vercel, or use a service account JSON locally.
# ----------------------------------------------------
FIREBASE_PROJECT_ID=lifepulse-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ----------------------------------------------------
# 2. Twilio Communications Gateway (SMS & WhatsApp)
# Get credentials at: https://console.twilio.com
# ----------------------------------------------------
# Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Twilio SMS sender phone number in E.164 format (e.g. +12055550199)
TWILIO_PHONE_NUMBER=+12055550199
# Twilio WhatsApp sender number (default sandbox: +14155238886)
TWILIO_WHATSAPP_NUMBER=+14155238886

# ----------------------------------------------------
# 3. Fast2SMS Indian SMS Gateway (Fallback / Direct DLT)
# Get API key at: https://www.fast2sms.com/dashboard/dev-api
# ----------------------------------------------------
FAST2SMS_API_KEY=your_fast2sms_authorization_key_here

# ----------------------------------------------------
# 4. Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
# ----------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@lifepulse.in

# ----------------------------------------------------
# 5. Brevo (formerly Sendinblue) Transactional Email
# Get API key at: https://app.brevo.com/settings/keys/api
# ----------------------------------------------------
BREVO_API_KEY=your_brevo_api_v3_key_here
BREVO_SENDER_EMAIL=your_verified_sender@yourdomain.com
BREVO_SENDER_NAME=RaktaRun Emergency Network

# ----------------------------------------------------
# 6. Groq vision-assisted donor certificate document screening
# The AI result is advisory; admin approval remains required.
# ----------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_CERTIFICATE_AI_MODEL=qwen/qwen3.8-27b

# Supabase server-only credentials. Never add SUPABASE_SECRET_KEY to client env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_CERTIFICATES_BUCKET=donor-certificates

# Protect the escalation endpoint when called by an external scheduler.
ESCALATION_CRON_SECRET=replace_with_a_long_random_secret

