{
  "name": "LifePulse Codespace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [5173, 5000],
  "portsAttributes": {
    "5173": {
      "label": "LifePulse Frontend",
      "onAutoForward": "openPreview"
    },
    "5000": {
      "label": "LifePulse API Backend",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "npm install && npm run build --prefix client",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
