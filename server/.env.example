PORT=5000
NODE_ENV=development

# ----------------------------------------------------
# 1. Firebase Admin SDK
# Place service account JSON at: server/firebase-service-account.json
# ----------------------------------------------------
FIREBASE_PROJECT_ID=lifepulse-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ----------------------------------------------------
# 2. Twilio Communications Gateway (SMS & WhatsApp)
# Get credentials at: https://console.twilio.com
# ----------------------------------------------------
# Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Twilio SMS sender phone number in E.164 format (e.g. +12055550199)
TWILIO_PHONE_NUMBER=+12055550199
# Twilio WhatsApp sender number (default sandbox: +14155238886)
TWILIO_WHATSAPP_NUMBER=+14155238886

# ----------------------------------------------------
# 3. Fast2SMS Indian SMS Gateway (Fallback / Direct DLT)
# Get API key at: https://www.fast2sms.com/dashboard/dev-api
# ----------------------------------------------------
FAST2SMS_API_KEY=your_fast2sms_authorization_key_here

# ----------------------------------------------------
# 4. Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
# ----------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@lifepulse.in

# ----------------------------------------------------
# 5. Brevo (formerly Sendinblue) Transactional Email
# Get API key at: https://app.brevo.com/settings/keys/api
# ----------------------------------------------------
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=emergency@lifepulse.in
BREVO_SENDER_NAME=LifePulse Emergency Network

